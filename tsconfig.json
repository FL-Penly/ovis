{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "types": [
      "bun",
      "react",
      "react-dom",
      "vite/client"
    ],
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "paths": {
      "@shared/*": [
        "./shared/*"
      ],
      "ovis-local/client": [
        "./src/lib/localExtensionsStub.ts"
      ]
    }
  },
  "include": [
    "src",
    "server",
    "shared",
    "telemetry",
    "push-relay",
    "vite.config.ts"
  ]
}
